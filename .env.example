# Copy to .env and fill in. The real values never go in the repo
# or in the workflow files. "npm run n8n" loads this file.

# Base URL of the time tracker API, without a trailing slash
TIME_TRACKER_API_URL=http://localhost:5001/api

# ID of the Google Sheet that holds the Exceptions and Runs tabs
# (the long string in the Sheet's URL)
SHEET_ID=your-google-sheet-id

# Address that receives the summary and alerts.
# They are sent from the Google account you connect in n8n.
MAIL_TO=recipient@example.com
